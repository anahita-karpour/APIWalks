{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*", //Incorrect for production. Should be restricted.
  "ConnectionStrings": {
    "NZWalksConnectionString": "Server=Localhost\\SQLExpress;Database=NZWalksDb;Trusted_Connection=True;TrustServerCertificate=True;Connect Timeout=120;", //TrustServerCertificate should be False in Production
    "NZWalksAuthConnectionString": "Server=Localhost\\SQLExpress;Database=NZWalksAuthDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    //"Key": "YOUR_VERY_SECURE_JWT_SECRET_KEY", // *****Will be replaced by environment variable in production.
    //"Key": "JwtKeyGenerator.GenerateKey()", // This line is used to generate a random key for the JWT secret key
    "Issuer": "https://localhost:7020/",
    "Audience": "https://localhost:7020/",
    "ValidateIssuer": true, // Boolean value
    "ValidateAudience": true, // Boolean value
    "ValidateLifetime": true, // Boolean value
    "AccessTokenDurationMinutes": 30, // Duration of the access token in minutes
    //"RefreshTokenDurationDays": 30, // Duration of the refresh token in days
    "RefreshTokenDurationMonths": 1,
    "expiresInMinutes": 30, // Duration of the access token in minutes"
    "JWTCookieName": "jwtToken" // Name of the cookie used for authentication"
  },
  "FileUpload": {
    "FileUploadPath": "wwwroot/Images", // the relative path where we want to save the uploaded images
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif" ], // an array of allowed file extensions for the uploaded images
    "MaxFileSizeInBytes": 10485760 // The maximum allowed file size in bytes: 10 MB in bytes
  }
}
///Important Security Note:  Do not store your actual JWT secret key directly in appsettings.json in a production environment.  
//This is a serious security risk. Use a more secure method, such as Azure Key Vault, HashiCorp Vault, or environment variables.
// The JWT Key should be stored securely.
// The AllowedHosts setting should be restricted in production.
//TrustServerCertificate=True should be changed to false for production.