@model NZWalks.UI.Models.DTO.RegionDto
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<h1 class="mt-3">Edit Region</h1>
@* <p>
@ViewBag.Id
</p> *@

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if(Model != null)
{
    <form method="post">
        <div class="form-group mt-3">
            <label class="form-label" for="id">Id</label>
            <input type="text" class="form-control" asp-for="Id" readonly/>
            <span asp-validation-for="Id" class="text-danger"></span>
        </div>
        <div class="form-group mt-3">
            <label class="form-label" for="code">Code</label>
            <input type="text" class="form-control" asp-for="Code" /> @*  Binding Control input elements to the properties we created inside the view model using asp-for *@
            @* asp-for="Code" means the Code properties of the ViewModel should be binded to this input element *@

            <span asp-validation-for="Code" class="text-danger"></span>
        </div>
        <div class="form-group mt-3">
            <label for="name" class="form-label">Name</label>
            <input type="text" class="form-control" asp-for="Name" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mt-3">
            <label for="image" class="form-label">Image URL</label>
            <input type="text" class="form-control" asp-for="RegionImageUrl" />
            <span asp-validation-for="RegionImageUrl" class="text-danger"></span>
        </div>
        @* <div class="mt-3"> *@
        <div class="mt-3 d-flex justify-content-between">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="submit" asp-controller="Regions" asp-action="Delete" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete @Model.Name?');" style="display:inline-block;">Delete</button>
        </div>
    </form>
}