@using NZWalks.UI.Models.ViewModel

@model AddRegionViewModelWithErrorMessage



@* Create a form for submitting region data from the web application to the API *@

<h1 class="mt-3">Add Region</h1>

@* @if (ViewBag.ErrorMessage != null)
{
    <p class="alert alert-danger">@ViewBag.ErrorMessage</p>
} *@
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<form method="post">
    <div class="form-group mt-3">
        <label class="form-label" asp-for="RegionViewModel.Code">Code</label>
        <input type="text" class="form-control" asp-for="RegionViewModel.Code" /> @*  Binding Control input elements to the properties we created inside the view model using asp-for *@
                                                                   @* asp-for="Code" means the Code properties of the ViewModel should be binded to this input element *@

        <span asp-validation-for="RegionViewModel.Code" class="text-danger"></span>
    </div>                                                         
    <div class="form-group mt-3">
        <label asp-for="RegionViewModel.Name" class="form-label">Name</label>
        <input type="text" class="form-control" asp-for="RegionViewModel.Name" />
        <span asp-validation-for="RegionViewModel.Name" class="text-danger"></span>
    </div>
    <div class="form-group mt-3">
        <label asp-for="RegionViewModel.RegionImageUrl" class="form-label">Image URL</label>
        <input type="text" class="form-control" asp-for="RegionViewModel.RegionImageUrl"/>
        <span asp-validation-for="RegionViewModel.RegionImageUrl" class="text-danger"></span>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Submit</button>
    </div>
</form>
