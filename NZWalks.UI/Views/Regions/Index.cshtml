@using System.Security.Claims

@model IEnumerable<NZWalks.UI.Models.DTO.RegionDto>

@{    
    var jwtToken = Context.Request.Cookies["jwtToken"];
    string userRole = null;
   

    if (!string.IsNullOrEmpty(jwtToken))
    {
        var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
        var token = handler.ReadJwtToken(jwtToken);
        if (token != null)
        {
            userRole = token.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;
        }
        else
        {
            <script>
                console.log("JWT Token is invalid and could not be read.");
            </script>
        }
    }
}



<h1 class="mt-3">Regions</h1> <!--margin top of 3-->
@if (userRole == "Writer" || userRole == "Admin")
{
    <div class="d-flex justify-content-end">
        <a class="btn btn-secondary" asp-controller="Regions" asp-action="Add">Add Region</a><!--if you submit this it will go to the Add index page-->
    </div>
}

<div class="form-group">
    <table class="table table-responsive table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Code</th>
                <th>Name</th>
                <th>Image</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null){
                @foreach(var region in Model)
                {
                    <tr>
                        <td>@region.Id</td>
                        <td>@region.Code</td>
                        <td>@region.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(region.RegionImageUrl)) //if the image url is not empty
                            {
                                <img src="@region.RegionImageUrl" alt="@region.Name" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" loading="lazy" />
                            }
                        </td>
                        <td>
                            @if (userRole == "Writer" || userRole == "Admin")
                            {
                                <a asp-controller= "Regions" asp-action="Edit" asp-route-id="@region.Id" class="btn btn-light">Edit</a>
                                <form asp-controller="Regions" asp-action="Delete" asp-route-id="@region.Id" method="post" onclick="return confirm('Are you sure you want to delete @region.Name?');" style="display:inline-block;">
                                    <input type="hidden" name="id" value="@region.Id" />
                                    <button type="submit" class="btn btn-light">Delete</button>
                                </form>
                            }
                        </td>
                </tr>
            }
        }
    </tbody>
</table>    
</div>
