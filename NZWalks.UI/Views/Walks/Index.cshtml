@model IEnumerable<NZWalks.API.Models.DTO.WalkDto>
@{   
    var jwtToken = Context.Request.Cookies["jwtToken"];
    string userRole = null;
   

    if (!string.IsNullOrEmpty(jwtToken))
    {
        var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
        var token = handler.ReadJwtToken(jwtToken);
        if (token != null)
        {
            userRole = token.Claims.FirstOrDefault(c => c.Type == "role")?.Value;
        }
        else
        {
            <script>
                console.log("JWT Token is invalid and could not be read.");
            </script>
        }
    }
}

<h1 class="mt-3">Walks</h1> <!--margin top of 3-->

<div class="d-flex justify-content-end">
    <a class="btn btn-secondary" asp-controller="Walks" asp-action="Add">Add Walks</a> <!--if you submit this it will go to the Add Walks page-->
</div>
<div class="form-group">
    <table class="table table-responsive table-striped table-hover">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Length(Km)</th>
                <th>Image</th>
                <th>Difficulty</th>
                <th>Region</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var walk in Model)
                {
                    <tr>
                        <td>@walk.Id</td>
                        <td>@walk.Name</td>
                        <td>@walk.Description</td>
                        <td>@walk.LengthInKm</td>
                        <td>
                            @if (!string.IsNullOrEmpty(walk.WalkImageUrl)) //if the image url is not empty
                            {
                                <img src="@walk.WalkImageUrl" alt="@walk.Name" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" loading="lazy" />
                            }
                        </td>
                        <td>@walk.Difficulty?.Name</td>
                        <td>@walk.Region?.Name</td>
                        <td>
                            @if (userRole == "Writer")
                            {
                                <a asp-controller="Walks" asp-action="Edit" asp-route-id="@walk.Id" class="btn btn-light">Edit</a>
                                <form asp-controller="Walks" asp-action="Delete" asp-route-id="@walk.Id" method="post" onsubmit="return confirm('Are you sure you want to delete @walk.Name?');" style="display:inline-block;">
                                    <button type="submit" class="btn btn-light">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>